#!/usr/bin/env bash
# SparkFabrik managed statusline for Claude Code.
#
# Opt-in. Enable/disable via the shared recipe (single source, cross-platform):
#   sjust claude-statusline-enable     # macOS
#   ajust claude-statusline-enable     # Arch (imports the same shared recipe)
# or wire it manually in ~/.claude/settings.json:
#   "statusLine": { "type": "command",
#     "command": "bash /opt/sparkdock/config/bin/sparkfabrik-claude-statusline" }
#
# Claude Code pipes a JSON blob on stdin each render and shows whatever this
# prints on stdout. Portable across macOS (bash 3.2) and Linux. Requires jq
# (shipped by sparkdock); degrades to a minimal bar if jq is absent.
#
# Security: the output is rendered to the terminal on every render, so every
# value we emit is stripped of control/escape bytes — git branch names, paths,
# and model strings can otherwise carry ANSI escapes or OSC hyperlink spoofs.
set -uo pipefail

INPUT=$(cat)
SEP=$' \033[38;5;240m|\033[0m '   # dim pipe separator
out=""

append() {
  [ -n "$1" ] || return 0
  if [ -n "$out" ]; then out="$out$SEP$1"; else out="$1"; fi
}

# Strip C0 control bytes (incl. ESC) from any value before rendering it.
clean() { printf '%s' "$1" | tr -d '\000-\037'; }

# --- caveman badge (compose, never duplicate) --------------------------------
# Single source of truth: exec the plugin's own hardened badge script if it is
# present and not a symlink. Its output already self-sanitizes.
CAVEMAN="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/caveman-statusline.sh"
if [ -f "$CAVEMAN" ] && [ ! -L "$CAVEMAN" ]; then
  badge=$(bash "$CAVEMAN" 2>/dev/null) || badge=""
  [ -n "$badge" ] && out="$badge"
fi

# --- parse Claude Code's JSON -------------------------------------------------
if command -v jq >/dev/null 2>&1; then
  cur_dir=$(printf '%s' "$INPUT" | jq -r '.workspace.current_dir // .cwd // empty')
  model=$(printf '%s'   "$INPUT" | jq -r '.model.display_name // empty')
  over200=$(printf '%s' "$INPUT" | jq -r '.exceeds_200k_tokens // false')
  cost=$(printf '%s'    "$INPUT" | jq -r '.cost.total_cost_usd // empty')
else
  cur_dir="$PWD"; model=""; over200="false"; cost=""
fi

# --- dir ----------------------------------------------------------------------
if [ -n "$cur_dir" ]; then
  append "$(printf '\033[36m%s\033[0m' "$(clean "$(basename "$cur_dir")")")"
fi

# --- git branch ---------------------------------------------------------------
if [ -n "$cur_dir" ]; then
  branch=$(git -C "$cur_dir" rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
  if [ -n "$branch" ]; then
    append "$(printf '\033[35m\xee\x82\xa0 %s\033[0m' "$(clean "$branch")")"
  fi
fi

# --- model --------------------------------------------------------------------
[ -n "$model" ] && append "$(printf '\033[33m%s\033[0m' "$(clean "$model")")"

# --- context warning ----------------------------------------------------------
[ "$over200" = "true" ] && append "$(printf '\033[31m\xe2\x9a\xa0 200k+\033[0m')"

# --- session cost -------------------------------------------------------------
if [ -n "$cost" ] && [ "$cost" != "null" ]; then
  if formatted=$(printf '%.2f' "$cost" 2>/dev/null); then
    append "$(printf '\033[32m$%s\033[0m' "$formatted")"
  else
    append "$(printf '\033[32m$%s\033[0m' "$(clean "$cost")")"
  fi
fi

printf '%s' "$out"
