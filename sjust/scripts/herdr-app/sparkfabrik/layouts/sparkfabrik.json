{
  "id": "root",
  "type": "row",
  "theme": {
    "light": "sparkfabrik-light",
    "dark": "sparkfabrik"
  },
  "ui_font": "Barlow",
  "preview": "layouts/sparkfabrik.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "sparkfabrik-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "sparkfabrik-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "sparkfabrik-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 44
          },
          "content": {
            "mod": "sparkfabrik-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 44
          },
          "window_drag": true,
          "content": {
            "mod": "sparkfabrik-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 12,
          "gap": 12,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 6,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "ring"
                  },
                  "header": {
                    "content": {
                      "mod": "sparkfabrik-pane"
                    },
                    "height": 36,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 44
          },
          "content": {
            "mod": "sparkfabrik-status"
          }
        }
      ]
    }
  ]
}
