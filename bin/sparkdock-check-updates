#!/usr/bin/env bash

set -euo pipefail

# sparkdock-check-updates — Dispatcher for update checks across sparkdock subsystems.
# Usage: sparkdock-check-updates <sparkdock|http-proxy|skills|timetracker|engram|vulns [--force]>
# Exit codes: 0 = updates available, 1 = no updates available, 2 = error/usage, 3 = not configured

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
DEFAULT_BRANCH="${DEFAULT_BRANCH:-master}"
BREW_VULNS_CACHE_FILE="${HOME}/.cache/sparkdock/brew-vulns"
BREW_VULNS_CACHE_MINUTES=1440

# Determine sparkdock root directory
get_root_dir() {
    if [[ -d "/opt/sparkdock" ]] && [[ "${SCRIPT_DIR}" == "/opt/sparkdock/"* ]]; then
        echo "/opt/sparkdock"
    else
        echo "${SCRIPT_DIR}/.."
    fi
}

SPARKDOCK_ROOT="$(get_root_dir)"

# Check for sparkdock updates (compares local HEAD vs origin)
# Uses subshell to isolate cd
check_sparkdock_updates() (
    set -euo pipefail
    local sparkdock_dir="${SPARKDOCK_ROOT}"

    if [[ "${sparkdock_dir}" != "/opt/sparkdock" ]]; then
        return 1
    fi

    cd "${sparkdock_dir}"
    git fetch origin "${DEFAULT_BRANCH}" -q
    local local_rev remote_rev
    local_rev=$(git rev-parse HEAD)
    remote_rev=$(git rev-parse "origin/${DEFAULT_BRANCH}")

    if [[ "${local_rev}" != "${remote_rev}" ]]; then
        echo "Updates available:"
        git --no-pager log --oneline "HEAD..origin/${DEFAULT_BRANCH}"
        return 0
    fi
    return 1
)

# Check for http-proxy updates
# Uses subshell to isolate cd
check_http_proxy_updates() (
    set -euo pipefail
    local http_proxy_dir="/opt/sparkdock/http-proxy"

    if [[ ! -d "${http_proxy_dir}" ]]; then
        return 1
    fi

    cd "${http_proxy_dir}"

    if [[ ! -d ".git" ]]; then
        return 1
    fi

    git fetch origin main -q
    local local_rev remote_rev
    local_rev=$(git rev-parse HEAD)
    remote_rev=$(git rev-parse origin/main)

    if [[ "${local_rev}" != "${remote_rev}" ]]; then
        echo "Http-proxy updates available:"
        git --no-pager log --oneline HEAD..origin/main
        return 0
    fi
    return 1
)

# Check for agent skills updates
# Uses subshell to isolate cd
check_skills_updates() (
    set -euo pipefail
    local skills_cache_dir="${HOME}/.cache/sparkdock/agent-skills"

    # If cache doesn't exist, skills haven't been synced yet
    if [[ ! -d "${skills_cache_dir}" ]]; then
        return 3
    fi

    cd "${skills_cache_dir}"

    if [[ ! -d ".git" ]]; then
        return 3
    fi

    git fetch origin -q 2>/dev/null || return 1

    local default_branch_name
    default_branch_name=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || echo "main")

    local local_rev remote_rev
    local_rev=$(git rev-parse HEAD)
    remote_rev=$(git rev-parse "origin/${default_branch_name}" 2>/dev/null || echo "")

    if [[ -z "${remote_rev}" ]]; then
        return 1
    fi

    if [[ "${local_rev}" != "${remote_rev}" ]]; then
        echo "Agent skills updates available"
        return 0
    fi
    return 1
)

# Check for timetracker CLI updates
# Uses subshell to isolate the PATH override
# Each CLI check widens PATH in its own subshell on purpose, which the
# linter would otherwise read as one check depending on the other.
# shellcheck disable=SC2030
check_timetracker_updates() (
    set -euo pipefail

    # The menubar app runs this script from a LaunchAgent, whose PATH is
    # /usr/bin:/bin:/usr/sbin:/sbin — add the directories where user binaries
    # live so an installed timetracker is discoverable.
    export PATH="/opt/homebrew/bin:/usr/local/bin:${HOME}/.local/bin:${PATH}"

    if ! command -v timetracker >/dev/null 2>&1; then
        return 3
    fi

    # `timetracker update --check` mirrors this dispatcher's exit codes:
    # 0 = update available, 1 = up to date or server unreachable, 3 = not configured.
    local output rc=0
    output=$(timetracker update --check 2>&1) || rc=$?

    case "${rc}" in
        0)
            echo "Timetracker updates available:"
            if [[ -n "${output}" ]]; then
                echo "${output}"
            fi
            return 0
            ;;
        1)
            # Also the graceful path for a CLI too old to know `update --check`:
            # it exits 1 on an unknown command, reported here as "no updates".
            return 1
            ;;
        3)
            return 3
            ;;
        *)
            # Any other status is an unknown failure — report "not configured"
            # rather than claiming an update the user cannot act on.
            return 3
            ;;
    esac
)

# Check for engram CLI updates
# Uses subshell to isolate the PATH override
# shellcheck disable=SC2031
check_engram_updates() (
    set -euo pipefail

    # The menubar app runs this script from a LaunchAgent, whose PATH is
    # /usr/bin:/bin:/usr/sbin:/sbin — add the directories where user binaries
    # live so an installed engram is discoverable.
    export PATH="/opt/homebrew/bin:/usr/local/bin:${HOME}/.local/bin:${PATH}"

    if ! command -v engram >/dev/null 2>&1; then
        return 3
    fi

    # `engram update --check` mirrors this dispatcher's exit codes:
    # 0 = update available, 1 = up to date or hub unreachable, 3 = no hub configured.
    local output rc=0
    output=$(engram update --check 2>&1) || rc=$?

    case "${rc}" in
        0)
            echo "Engram updates available:"
            if [[ -n "${output}" ]]; then
                echo "${output}"
            fi
            return 0
            ;;
        1)
            return 1
            ;;
        3)
            return 3
            ;;
        *)
            # Any other status, including the usage error of a CLI too old to
            # know `update`, is reported as "not configured" rather than an
            # update the user cannot act on.
            return 3
            ;;
    esac
)

# Scan installed Homebrew formulae for known vulnerabilities (OSV.dev)
# Uses subshell to isolate the parsing helpers
scan_brew_vulns() (
    set -euo pipefail

    # The LaunchAgent PATH is /usr/bin:/bin:/usr/sbin:/sbin, so look in the Homebrew prefixes first.
    local brew_bin=""
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -x "${candidate}" ]]; then
            brew_bin="${candidate}"
            break
        fi
    done
    if [[ -z "${brew_bin}" ]]; then
        brew_bin="$(command -v brew 2>/dev/null || true)"
    fi
    if [[ -z "${brew_bin}" ]]; then
        return 3
    fi

    # `brew vulns` exits non-zero when it finds vulnerabilities, so only the JSON payload is read.
    local output=""
    output=$("${brew_bin}" vulns --json 2>/dev/null) || true

    # Only findings[].vulnerabilities counts; findings[].patched and skipped_formulae do not.
    local summary rc=0
    summary=$(printf '%s' "${output}" | python3 -c "
import json, sys
# Any unreadable payload exits 2: an unexpected shape must not read as 'none'.
try:
    data = json.loads(sys.stdin.read())
    if not isinstance(data, dict):
        raise ValueError('top-level value is not an object')
    findings = data['findings']
    if not isinstance(findings, list):
        raise ValueError('findings is not a list')
    total = severe = formulae = 0
    for finding in findings:
        vulns = finding['vulnerabilities']
        if not isinstance(vulns, list):
            raise ValueError('vulnerabilities is not a list')
        if not vulns:
            continue
        formulae += 1
        total += len(vulns)
        severe += sum(1 for v in vulns if str(v.get('severity', '')).upper() in ('HIGH', 'CRITICAL'))
except Exception:
    sys.exit(2)
if total == 0:
    sys.exit(1)
print('Homebrew vulnerabilities: %d in %d formulae, %d high or critical' % (total, formulae, severe))
") || rc=$?

    case "${rc}" in
        0)
            echo "${summary}"
            return 0
            ;;
        1)
            return 1
            ;;
        *)
            # Unparseable output means brew could not answer, which is not a clean bill.
            return 3
            ;;
    esac
)

# Check for Homebrew vulnerabilities, answering from a daily cache.
# The OSV scan is slow and network heavy, and the menu bar app checks on every
# wake and network change. Pass --force to scan regardless of the cache.
check_brew_vulns() {
    local force="${1:-}"
    local cache_file="${BREW_VULNS_CACHE_FILE}"

    if [[ "${force}" != "--force" ]] && [[ -n "$(find "${cache_file}" -mmin "-${BREW_VULNS_CACHE_MINUTES}" 2>/dev/null)" ]]; then
        local cached_rc="" cached_summary=""
        { read -r cached_rc; cached_summary="$(cat)"; } <"${cache_file}" || true
        if [[ "${cached_rc}" == "0" ]] || [[ "${cached_rc}" == "1" ]]; then
            if [[ -n "${cached_summary}" ]]; then
                echo "${cached_summary}"
            fi
            return "${cached_rc}"
        fi
    fi

    local summary="" rc=0
    summary="$(scan_brew_vulns)" || rc=$?
    if [[ -n "${summary}" ]]; then
        echo "${summary}"
    fi

    # Only a definite answer is cached, so a failed scan is retried on the next check.
    if [[ "${rc}" == "0" ]] || [[ "${rc}" == "1" ]]; then
        local tmp_file=""
        if mkdir -p "$(dirname "${cache_file}")" && tmp_file="$(mktemp "${cache_file}.XXXXXX")"; then
            if ! { printf '%s\n%s\n' "${rc}" "${summary}" >"${tmp_file}" && mv -f "${tmp_file}" "${cache_file}"; }; then
                rm -f "${tmp_file}"
            fi
        fi
    fi

    return "${rc}"
}

# Usage message
usage() {
    echo "Usage: ${SCRIPT_NAME} <subsystem>"
    echo ""
    echo "Check for updates in a sparkdock subsystem."
    echo ""
    echo "Subsystems:"
    echo "  sparkdock    Check for sparkdock core updates"
    echo "  http-proxy   Check for http-proxy updates"
    echo "  agents       Check for agent skills and agent profile updates"
    echo "  skills       (alias for agents)"
    echo "  timetracker  Check for timetracker CLI updates"
    echo "  engram       Check for engram CLI updates"
    echo "  vulns        Check installed Homebrew formulae for known vulnerabilities"
    echo "               (cached for a day; pass --force to scan again)"
    echo ""
    echo "Exit codes:"
    echo "  0  Updates available"
    echo "  1  No updates available"
    echo "  2  Usage error"
    echo "  3  Not configured (subsystem not set up yet)"
}

# Main dispatcher
main() {
    if [[ $# -lt 1 ]]; then
        usage
        exit 2
    fi

    local subsystem="$1"
    local rc=0

    case "${subsystem}" in
        sparkdock)
            check_sparkdock_updates || rc=$?
            ;;
        http-proxy)
            check_http_proxy_updates || rc=$?
            ;;
        skills|agents)
            check_skills_updates || rc=$?
            ;;
        timetracker)
            check_timetracker_updates || rc=$?
            ;;
        engram)
            check_engram_updates || rc=$?
            ;;
        vulns)
            check_brew_vulns "${2:-}" || rc=$?
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Error: Unknown subsystem '${subsystem}'"
            echo ""
            usage
            exit 2
            ;;
    esac

    exit "${rc}"
}

main "$@"
