#!/usr/bin/env bash

set -euo pipefail

# sparkdock-agents-status — Show status of agent skills and agent profiles
#                           (managed vs user-owned, up to date vs locally modified).

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"

# Source shared utility library (provides logging + compute_sha256)
# shellcheck source=common/utils.sh
source "${SCRIPT_DIR}/common/utils.sh"

# Source optional skill category configuration helpers
# shellcheck source=common/skill-categories.sh
source "${SCRIPT_DIR}/common/skill-categories.sh"

# Source skills symlink shim (temporary — see shim header for removal instructions)
# shellcheck source=common/skills-symlink-shim.sh
source "${SCRIPT_DIR}/common/skills-symlink-shim.sh"

SKILLS_DIR="${HOME}/.agents/skills"
MANIFEST_PATH="${HOME}/.cache/sparkdock/sf-skills-manifest.json"
CACHE_DIR="${HOME}/.cache/sparkdock/agent-skills"
SYSTEM_SKILLS_SUBDIR="skills/system"
SYSTEM_AGENTS_SUBDIR="agents/system"
CATALOG_PATH="${CACHE_DIR}/config/catalog.json"
HARNESS_RUNNER="$(get_harness_runner)"

# Skills this user disabled: still installed, but deliberately not linked.
load_disabled_skill_names
DISABLED_SKILLS_FOUND=false
RELOCATIONS_FOUND=false

# Delimiter for table data (tab avoids conflicts with commas in descriptions)
SEP=$'\t'

# Tool registry (must mirror sparkdock-agents-sync)
declare -A AGENT_TOOL_INSTALL_DIR=(
    [claude]="${HOME}/.claude/agents"
    [copilot]="${HOME}/.copilot/agents"
    [opencode]="${HOME}/.config/opencode/agents"
)

# Guard: python3 and perl are required
if ! command -v python3 &>/dev/null; then
    log_error "python3 is required but not found in PATH"
    exit 1
fi
if ! command -v perl &>/dev/null; then
    log_error "perl is required but not found in PATH"
    exit 1
fi

# --- Helpers ---

# Get SHA from manifest for a given section and key.
get_manifest_sha() {
    local section="$1"
    local key="$2"
    if [[ ! -f "${MANIFEST_PATH}" ]]; then
        echo ""
        return
    fi
    python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
    print(data.get(sys.argv[2], {}).get(sys.argv[3], {}).get('sha256', ''))
except Exception:
    print('')
" "${MANIFEST_PATH}" "${section}" "${key}" 2>/dev/null || echo ""
}

# Get short description from catalog.json for a given section and name.
# Truncates to max_len characters with ellipsis if needed.
get_catalog_description() {
    local section="$1"
    local name="$2"
    local max_len="${3:-60}"
    if [[ ! -f "${CATALOG_PATH}" ]]; then
        echo ""
        return
    fi
    python3 -c "
import json, sys
try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
    desc = data.get(sys.argv[2], {}).get(sys.argv[3], {}).get('description', '')
    desc = ' '.join(desc.split())
    max_len = int(sys.argv[4])
    if len(desc) > max_len:
        desc = desc[:max_len - 1] + '\u2026'
    print(desc)
except Exception:
    print('')
" "${CATALOG_PATH}" "${section}" "${name}" "${max_len}" 2>/dev/null || echo ""
}

# Echo the optional category that owns an upstream skill, or nothing. Covers
# every category on disk, enabled or not, so a skill that moved out of system
# is not mistaken for one that left upstream.
# Args: <skill_name>
find_upstream_category() {
    local skill_name="$1"
    local category_dir category

    [[ "${CACHE_AVAILABLE}" == "true" ]] || return 0
    for category_dir in "${CACHE_DIR}/${SKILLS_ROOT_SUBDIR}"/*/; do
        [[ -d "${category_dir}" ]] || continue
        category="$(basename "${category_dir}")"
        [[ "${category}" == "system" ]] && continue
        if [[ -f "${category_dir}/${skill_name}/SKILL.md" ]]; then
            printf '%s\n' "${category}"
            return
        fi
    done
}

# Check if an upstream resource exists at the given path.
# Returns 0 (conflict) or 1 (no conflict). Sets CONFLICTS_FOUND=true on hit.
has_upstream_conflict() {
    local upstream_path="$1"
    if [[ "${CACHE_AVAILABLE}" == "true" ]] && [[ -e "${upstream_path}" ]]; then
        CONFLICTS_FOUND=true
        return 0
    fi
    return 1
}

# Determine the status of a managed resource by comparing SHAs.
# Prints one of: "up to date", "update available", "locally modified".
# Args: <manifest_section> <manifest_key> <installed_file> <upstream_file>
#   upstream_file may be empty if unavailable.
resolve_managed_status() {
    local section="$1" key="$2" installed_file="$3" upstream_file="$4"
    local manifest_sha installed_sha upstream_sha

    manifest_sha=$(get_manifest_sha "${section}" "${key}")
    installed_sha=$(compute_sha256 "${installed_file}") || installed_sha=""

    if [[ "${manifest_sha}" != "${installed_sha}" ]]; then
        echo "locally modified"
        return
    fi

    # SHA matches manifest — check if upstream has a newer version
    if [[ -n "${upstream_file}" ]] && [[ -f "${upstream_file}" ]]; then
        upstream_sha=$(compute_sha256 "${upstream_file}") || upstream_sha=""
        if [[ -n "${upstream_sha}" ]] && [[ "${upstream_sha}" != "${installed_sha}" ]]; then
            echo "update available"
            return
        fi
    fi

    echo "up to date"
}

# Print a bold colored section label.
print_label() {
    local title="$1"
    if [[ "${HAS_GUM}" = true ]]; then
        gum style --bold --foreground 99 "${title}"
    else
        printf "${BOLD}%s${NC}\n" "${title}"
    fi
}

# Print dimmed text (adapts to terminal color scheme).
print_faint() {
    local text="$1"
    if [[ "${HAS_GUM}" = true ]]; then
        gum style --faint "${text}"
    else
        printf "\033[2m%s\033[0m\n" "${text}"
    fi
}

# Render a tab-delimited table using gum table (with fallback to column).
# Workaround: gum v0.17.0 has a bug (charmbracelet/gum#833) where --print mode
# applies bold styling to the first data row (selected-row state leaks).
# We strip bold escape sequences (\e[1m) via perl to neutralise this.
# --header.foreground is also broken (colors first data row, not header), so we
# only use --border.foreground for styling.
# Status values are colorized post-render so they don't break column alignment.
render_table() {
    local csv_data="$1"
    if [[ "${HAS_GUM}" = true ]]; then
        echo "${csv_data}" | gum table --print \
            --separator=$'\t' \
            --border.foreground 240 \
            | perl -pe '
                s/\e\[1m//g;
                s/update available/\e[38;5;40mupdate available\e[0m/g;
                s/up to date/\e[38;5;40mup to date\e[0m/g;
                s/locally modified/\e[38;5;220mlocally modified\e[0m/g;
                s/preserved conflict/\e[38;5;220mpreserved conflict\e[0m/g;
                s/disabled \(unlinked\)/\e[38;5;220mdisabled (unlinked)\e[0m/g;
                s/pending removal/\e[38;5;220mpending removal\e[0m/g;
                s/\bincomplete\b/\e[38;5;220mincomplete\e[0m/g;
                s/\bunavailable\b/\e[38;5;196munavailable\e[0m/g;
                s/conflicts with upstream/\e[38;5;220mconflicts with upstream\e[0m/g;
                s/removed from upstream/\e[38;5;196mremoved from upstream\e[0m/g;
                s/\borphan\b/\e[38;5;196morphan\e[0m/g;
                s/no SKILL\.md/\e[38;5;220mno SKILL.md\e[0m/g;
                s/not installed/\e[2mnot installed\e[0m/g;
                s/\bpartial\b/\e[38;5;220mpartial\e[0m/g;
                s/\bok\b/\e[38;5;40mok\e[0m/g;
                s/\boff\b/\e[2moff\e[0m/g;
                s/\bnative\b/\e[38;5;220mnative\e[0m/g;
                s/moved to [a-z0-9-]+/\e[38;5;220m$&\e[0m/g;
                s/\bmigrated\b/\e[38;5;220mmigrated\e[0m/g;
            '
    else
        echo "${csv_data}" | column -t -s $'\t'
    fi
}

get_category_health() {
    local category="$1"
    local state="$2"
    local manifest_section="$3"
    local category_dir="${CACHE_DIR}/${SKILLS_ROOT_SUBDIR}/${category}"
    local total
    total="$(count_category_skills "${category}")"
    local installed=0
    local has_missing=false
    local has_modified=false
    local has_update=false
    local skill_dir skill_name manifest_key manifest_sha installed_sha upstream_sha target_file

    if [[ "${state}" == "disabled" ]]; then
        local optional_keys
        optional_keys="$(manifest_list_keys "${OPTIONAL_SKILLS_MANIFEST_SECTION}")"
        while IFS= read -r manifest_key; do
            [[ "${manifest_key}" == "${category}/"* ]] || continue
            skill_name="${manifest_key#*/}"
            target_file="${SKILLS_DIR}/${skill_name}/SKILL.md"
            [[ -f "${target_file}" ]] || continue
            installed=$((installed + 1))
            manifest_sha="$(get_manifest_sha "${OPTIONAL_SKILLS_MANIFEST_SECTION}" "${manifest_key}")"
            installed_sha="$(compute_sha256 "${target_file}")"
            [[ "${manifest_sha}" != "${installed_sha}" ]] && has_modified=true
        done <<< "${optional_keys}"

        CATEGORY_INSTALLED="${installed}/${total}"
        CATEGORY_HEALTH="-"
        if [[ "${installed}" -gt 0 ]]; then
            CATEGORY_HEALTH="pending removal"
            [[ "${has_modified}" == "true" ]] && CATEGORY_HEALTH="preserved conflict"
        fi
        return
    fi

    if [[ ! -d "${category_dir}" ]]; then
        CATEGORY_INSTALLED="0/0"
        CATEGORY_HEALTH="unavailable"
        return
    fi

    for skill_dir in "${category_dir}"/*/; do
        [[ -f "${skill_dir}/SKILL.md" ]] || continue
        skill_name="$(basename "${skill_dir}")"
        manifest_key="${skill_name}"
        [[ "${manifest_section}" == "${OPTIONAL_SKILLS_MANIFEST_SECTION}" ]] && manifest_key="${category}/${skill_name}"
        target_file="${SKILLS_DIR}/${skill_name}/SKILL.md"
        manifest_sha="$(get_manifest_sha "${manifest_section}" "${manifest_key}")"

        if [[ ! -f "${target_file}" || -z "${manifest_sha}" ]]; then
            has_missing=true
            continue
        fi

        installed=$((installed + 1))
        installed_sha="$(compute_sha256 "${target_file}")"
        if [[ "${manifest_sha}" != "${installed_sha}" ]]; then
            has_modified=true
            continue
        fi

        upstream_sha="$(compute_sha256 "${skill_dir}/SKILL.md")"
        [[ "${upstream_sha}" != "${installed_sha}" ]] && has_update=true
    done

    CATEGORY_INSTALLED="${installed}/${total}"
    CATEGORY_HEALTH="up to date"
    if [[ "${has_update}" == "true" ]]; then
        CATEGORY_HEALTH="update available"
        UPDATES_AVAILABLE=true
    fi
    [[ "${has_missing}" == "true" ]] && CATEGORY_HEALTH="incomplete"
    [[ "${has_modified}" == "true" ]] && CATEGORY_HEALTH="locally modified"
    return 0
}

print_skill_categories() {
    local enabled_output
    enabled_output="$(list_enabled_skill_categories)"
    declare -gA ENABLED_SKILL_CATEGORIES=()
    local category
    if [[ -n "${enabled_output}" ]]; then
        while IFS= read -r category; do
            [[ -n "${category}" ]] && ENABLED_SKILL_CATEGORIES["${category}"]=1
        done <<< "${enabled_output}"
    fi

    local categories_csv="CATEGORY${SEP}POLICY${SEP}STATE${SEP}INSTALLED${SEP}HEALTH"
    get_category_health "system" "always" "skills"
    categories_csv+=$'\n'"system${SEP}required${SEP}always${SEP}${CATEGORY_INSTALLED}${SEP}${CATEGORY_HEALTH}"

    local available_output
    available_output="$(list_available_skill_categories)"
    declare -A available_categories=()
    if [[ -n "${available_output}" ]]; then
        while IFS= read -r category; do
            [[ -n "${category}" ]] && available_categories["${category}"]=1
        done <<< "${available_output}"
    fi

    for category in $(printf '%s\n' "${!available_categories[@]}" | sort); do
        local state="disabled"
        [[ -n "${ENABLED_SKILL_CATEGORIES[${category}]+_}" ]] && state="enabled"
        get_category_health "${category}" "${state}" "${OPTIONAL_SKILLS_MANIFEST_SECTION}"
        categories_csv+=$'\n'"${category}${SEP}optional${SEP}${state}${SEP}${CATEGORY_INSTALLED}${SEP}${CATEGORY_HEALTH}"
    done

    for category in $(printf '%s\n' "${!ENABLED_SKILL_CATEGORIES[@]}" | sort); do
        [[ -n "${available_categories[${category}]+_}" ]] && continue
        get_category_health "${category}" "enabled" "${OPTIONAL_SKILLS_MANIFEST_SECTION}"
        categories_csv+=$'\n'"${category}${SEP}optional${SEP}enabled${SEP}${CATEGORY_INSTALLED}${SEP}${CATEGORY_HEALTH}"
    done

    declare -A manifest_categories=()
    local manifest_key
    while IFS= read -r manifest_key; do
        [[ -n "${manifest_key}" ]] || continue
        manifest_categories["${manifest_key%%/*}"]=1
    done < <(manifest_list_keys "${OPTIONAL_SKILLS_MANIFEST_SECTION}")
    for category in $(printf '%s\n' "${!manifest_categories[@]}" | sort); do
        [[ -n "${available_categories[${category}]+_}" ]] && continue
        [[ -n "${ENABLED_SKILL_CATEGORIES[${category}]+_}" ]] && continue
        get_category_health "${category}" "disabled" "${OPTIONAL_SKILLS_MANIFEST_SECTION}"
        categories_csv+=$'\n'"${category}${SEP}optional${SEP}disabled${SEP}${CATEGORY_INSTALLED}${SEP}${CATEGORY_HEALTH}"
    done

    print_label "Skill Categories"
    render_table "${categories_csv}"
    print_faint "Configuration: ${HARNESS_CONFIG_PATH}"
}

# --- Upstream cache ---

log_section "Skills & Agent Profiles"

CACHE_AVAILABLE=false
CONFLICTS_FOUND=false
UPDATES_AVAILABLE=false
NEW_RESOURCES_AVAILABLE=false
ORPHANS_FOUND=false
if [[ -d "${CACHE_DIR}/.git" ]]; then
    if [[ "${SPARKDOCK_SKIP_FETCH:-}" == "true" ]]; then
        CACHE_AVAILABLE=true
    elif run_with_spinner "Fetching upstream..." \
            git -C "${CACHE_DIR}" fetch origin -q; then
        git -C "${CACHE_DIR}" reset --hard origin/main -q 2>/dev/null
        CACHE_AVAILABLE=true
    else
        log_warn "Could not reach upstream — status may not reflect latest changes."
        CACHE_AVAILABLE=true  # Still use whatever is cached locally
    fi
fi

# --- Skills section ---

managed_skills="$(manifest_list_keys "skills")"
managed_optional_skills="$(manifest_list_keys "${OPTIONAL_SKILLS_MANIFEST_SECTION}")"
declare -A optional_skill_keys=()
declare -A optional_skill_categories=()
while IFS= read -r manifest_key; do
    [[ -n "${manifest_key}" ]] || continue
    skill_name="${manifest_key#*/}"
    optional_skill_keys["${skill_name}"]="${manifest_key}"
    optional_skill_categories["${skill_name}"]="${manifest_key%%/*}"
done <<< "${managed_optional_skills}"

print_skill_categories
echo ""

# Build CSV header dynamically from tool registry (sorted for stable column order).
# Optional tools absent from this machine get no column at all.
sorted_tool_ids=()
while IFS= read -r _tid; do
    tool_is_enabled "${_tid}" || continue
    sorted_tool_ids+=("${_tid}")
done < <(printf '%s\n' "${!TOOL_SKILLS_DIR[@]}" | sort)
skills_header="NAME${SEP}TYPE${SEP}STATUS${SEP}DESCRIPTION"
unmanaged_skills_table="NAME${SEP}STATUS${SEP}PATH"
empty_tool_cols=""
for _tid in "${sorted_tool_ids[@]}"; do
    skills_header+="${SEP}$(echo "${_tid}" | tr '[:lower:]' '[:upper:]')"
    unmanaged_skills_table+="${SEP}$(echo "${_tid}" | tr '[:lower:]' '[:upper:]')"
    empty_tool_cols+="${SEP}"
done
unmanaged_skills_found=false

skills_found=false
declare -A seen_skills=()
declare -A skills_csv_by_group=()
declare -A skills_found_by_group=()

append_skill_row() {
    local group="$1"
    local row="$2"
    if [[ -z "${skills_csv_by_group[${group}]+_}" ]]; then
        skills_csv_by_group["${group}"]="${skills_header}"
    fi
    skills_csv_by_group["${group}"]+=$'\n'"${row}"
    skills_found_by_group["${group}"]=1
    skills_found=true
}

check_unmanaged_tool_availability() {
    local tool_id="$1"
    local skill_name="$2"
    local native

    for native in "${TOOLS_NATIVE_DISCOVERY[@]}"; do
        if [[ "${tool_id}" == "${native}" ]]; then
            [[ -f "${SKILLS_DIR}/${skill_name}/SKILL.md" ]] && TOOL_AVAILABLE="ok" || TOOL_AVAILABLE="-"
            return
        fi
    done

    [[ -f "${TOOL_SKILLS_DIR[${tool_id}]}/${skill_name}/SKILL.md" ]] && TOOL_AVAILABLE="ok" || TOOL_AVAILABLE="-"
}

append_unmanaged_skill_row() {
    local skill_name="$1"
    local status="$2"
    local skill_path="$3"
    local display_path="${skill_path}"
    local link_target
    local availability_cols=""

    if [[ "${display_path}" == "${HOME}/"* ]]; then
        printf -v display_path '%s/%s' '~' "${display_path#"${HOME}/"}"
    fi

    if [[ -L "${skill_path}" ]]; then
        link_target="$(readlink "${skill_path}")"
        if [[ "${link_target}" == "${HOME}/"* ]]; then
            printf -v link_target '%s/%s' '~' "${link_target#"${HOME}/"}"
        fi
        display_path+=" -> ${link_target}"
    fi

    for _tid in "${sorted_tool_ids[@]}"; do
        check_unmanaged_tool_availability "${_tid}" "${skill_name}"
        availability_cols+="${SEP}${TOOL_AVAILABLE}"
    done

    unmanaged_skills_table+=$'\n'"${skill_name}${SEP}${status}${SEP}${display_path}${availability_cols}"
    unmanaged_skills_found=true
    skills_found=true
}

if [[ -d "${SKILLS_DIR}" ]]; then
    for skill_dir in "${SKILLS_DIR}"/*/; do
        [[ -d "${skill_dir}" ]] || continue
        skill_name=$(basename "${skill_dir}")
        seen_skills["${skill_name}"]=1

        skill_group="user"
        manifest_section=""
        manifest_key=""
        upstream_file=""
        if echo "${managed_skills}" | grep -Fqx "${skill_name}"; then
            skill_group="system"
            manifest_section="skills"
            manifest_key="${skill_name}"
            upstream_file="${CACHE_DIR}/${SYSTEM_SKILLS_SUBDIR}/${skill_name}/SKILL.md"
        elif [[ -n "${optional_skill_keys[${skill_name}]+_}" ]]; then
            skill_group="${optional_skill_categories[${skill_name}]}"
            manifest_section="${OPTIONAL_SKILLS_MANIFEST_SECTION}"
            manifest_key="${optional_skill_keys[${skill_name}]}"
            upstream_file="${CACHE_DIR}/${SKILLS_ROOT_SUBDIR}/${skill_group}/${skill_name}/SKILL.md"
        fi

        if [[ ! -f "${skill_dir}/SKILL.md" ]]; then
            if [[ -z "${manifest_section}" ]]; then
                append_unmanaged_skill_row "${skill_name}" "no SKILL.md" "${skill_dir%/}"
            else
                append_skill_row "${skill_group}" \
                    "${skill_name}${SEP}incomplete${SEP}no SKILL.md${SEP}${empty_tool_cols}"
            fi
            continue
        fi

        if [[ -n "${manifest_section}" ]]; then
            # Check if this managed skill is orphaned (no longer in upstream)
            if [[ "${CACHE_AVAILABLE}" == "true" ]] && \
               [[ ! -f "${upstream_file}" ]] && \
               [[ "${skill_group}" == "system" || -n "${ENABLED_SKILL_CATEGORIES[${skill_group}]+_}" ]]; then
                moved_to="$(find_upstream_category "${skill_name}")"
                if [[ -n "${moved_to}" ]]; then
                    RELOCATIONS_FOUND=true
                    append_skill_row "${skill_group}" \
                        "${skill_name}${SEP}migrated${SEP}moved to ${moved_to}${SEP}${empty_tool_cols}"
                    continue
                fi
                ORPHANS_FOUND=true
                append_skill_row "${skill_group}" \
                    "${skill_name}${SEP}orphan${SEP}removed from upstream${SEP}${empty_tool_cols}"
                continue
            fi

            # Check availability for each registered tool (must be called directly, not in subshell)
            availability_cols=""
            for _tid in "${sorted_tool_ids[@]}"; do
                check_tool_availability "${_tid}" "${skill_name}"
                availability_cols+="${SEP}${TOOL_AVAILABLE}"
            done

            [[ "${CACHE_AVAILABLE}" != "true" || ! -f "${upstream_file}" ]] && upstream_file=""
            status=$(resolve_managed_status "${manifest_section}" "${manifest_key}" "${skill_dir}/SKILL.md" "${upstream_file}")
            if [[ "${skill_group}" != "system" ]] && [[ -z "${ENABLED_SKILL_CATEGORIES[${skill_group}]+_}" ]]; then
                status="preserved conflict"
            fi
            [[ "${status}" == "update available" ]] && UPDATES_AVAILABLE=true
            if skill_is_disabled "${skill_name}"; then
                status="disabled (unlinked)"
                DISABLED_SKILLS_FOUND=true
            fi
            skill_desc=$(get_catalog_description "skills" "${skill_name}")
            append_skill_row "${skill_group}" \
                "${skill_name}${SEP}managed${SEP}${status}${SEP}${skill_desc}${availability_cols}"
        else
            conflict_path="${CACHE_DIR}/${SYSTEM_SKILLS_SUBDIR}/${skill_name}/SKILL.md"
            if [[ ! -f "${conflict_path}" ]]; then
                for category in "${!ENABLED_SKILL_CATEGORIES[@]}"; do
                    candidate_path="${CACHE_DIR}/${SKILLS_ROOT_SUBDIR}/${category}/${skill_name}/SKILL.md"
                    if [[ -f "${candidate_path}" ]]; then
                        conflict_path="${candidate_path}"
                        break
                    fi
                done
            fi

            if has_upstream_conflict "${conflict_path}"; then
                append_unmanaged_skill_row \
                    "${skill_name}" "conflicts with upstream" "${skill_dir%/}"
            else
                append_unmanaged_skill_row "${skill_name}" "-" "${skill_dir%/}"
            fi
        fi
    done
fi

# Show required system skills available upstream but not installed locally.
if [[ "${CACHE_AVAILABLE}" == "true" ]]; then
    upstream_skills_dir="${CACHE_DIR}/${SYSTEM_SKILLS_SUBDIR}"
    if [[ -d "${upstream_skills_dir}" ]]; then
        for skill_dir in "${upstream_skills_dir}"/*/; do
            [[ -d "${skill_dir}" ]] || continue
            skill_name=$(basename "${skill_dir}")
            [[ -f "${skill_dir}/SKILL.md" ]] || continue
            # Skip if already seen locally
            [[ -n "${seen_skills[${skill_name}]+_}" ]] && continue
            NEW_RESOURCES_AVAILABLE=true
            new_skill_desc=$(get_catalog_description "skills" "${skill_name}")
            append_skill_row "system" \
                "${skill_name}${SEP}available${SEP}not installed${SEP}${new_skill_desc}${empty_tool_cols}"
        done
    fi
fi

# Show missing skills only for enabled optional categories.
if [[ "${CACHE_AVAILABLE}" == "true" ]]; then
    for category in $(printf '%s\n' "${!ENABLED_SKILL_CATEGORIES[@]}" | sort); do
        upstream_skills_dir="${CACHE_DIR}/${SKILLS_ROOT_SUBDIR}/${category}"
        [[ -d "${upstream_skills_dir}" ]] || continue
        for skill_dir in "${upstream_skills_dir}"/*/; do
            [[ -f "${skill_dir}/SKILL.md" ]] || continue
            skill_name="$(basename "${skill_dir}")"
            [[ -n "${seen_skills[${skill_name}]+_}" ]] && continue
            NEW_RESOURCES_AVAILABLE=true
            new_skill_desc=$(get_catalog_description "skills" "${skill_name}")
            append_skill_row "${category}" \
                "${skill_name}${SEP}available${SEP}not installed${SEP}${new_skill_desc}${empty_tool_cols}"
        done
    done
fi

if [[ "${skills_found}" != true ]]; then
    print_label "Skills"
    echo "  (no skills installed)"
else
    if [[ -n "${skills_found_by_group[system]+_}" ]]; then
        print_label "Skills: system (always enabled)"
        render_table "${skills_csv_by_group[system]}"
    fi

    for skill_group in $(printf '%s\n' "${!skills_found_by_group[@]}" | sort); do
        [[ "${skill_group}" == "system" || "${skill_group}" == "user" ]] && continue
        echo ""
        group_state="disabled, preserved"
        [[ -n "${ENABLED_SKILL_CATEGORIES[${skill_group}]+_}" ]] && group_state="enabled"
        print_label "Skills: ${skill_group} (${group_state})"
        render_table "${skills_csv_by_group[${skill_group}]}"
    done

    if [[ "${unmanaged_skills_found}" == "true" ]]; then
        echo ""
        print_label "Unmanaged skills"
        render_table "${unmanaged_skills_table}"
    fi
fi

# --- Agents section ---

echo ""
managed_agents="$(manifest_list_keys "agents")"
agents_csv="NAME${SEP}TOOL${SEP}TYPE${SEP}STATUS${SEP}DESCRIPTION"
agents_found=false
declare -A seen_agents=()

for tool_name in $(printf '%s\n' "${!AGENT_TOOL_INSTALL_DIR[@]}" | sort); do
    local_install_dir="${AGENT_TOOL_INSTALL_DIR[${tool_name}]}"
    [[ -d "${local_install_dir}" ]] || continue

    for agent_file in "${local_install_dir}"/*.md; do
        [[ -f "${agent_file}" ]] || continue
        agents_found=true

        filename="$(basename "${agent_file}")"
        agent_name="${filename%.agent.md}"
        if [[ "${agent_name}" == "${filename}" ]]; then
            agent_name="${filename%.md}"
        fi

        manifest_key="${agent_name}/${tool_name}"
        seen_agents["${manifest_key}"]=1

        if echo "${managed_agents}" | grep -Fqx "${manifest_key}"; then
            # Check if this managed agent is orphaned (no longer in upstream)
            upstream_dir="${CACHE_DIR}/${SYSTEM_AGENTS_SUBDIR}/${agent_name}/${tool_name}"
            if [[ "${CACHE_AVAILABLE}" == "true" ]]; then
                has_upstream_md=false
                if [[ -d "${upstream_dir}" ]]; then
                    for f in "${upstream_dir}"/*.md; do
                        [[ -f "${f}" ]] && has_upstream_md=true && break
                    done
                fi
                if [[ "${has_upstream_md}" == "false" ]]; then
                    ORPHANS_FOUND=true
                    agents_csv+=$'\n'"${agent_name}${SEP}${tool_name}${SEP}orphan${SEP}removed from upstream${SEP}"
                    continue
                fi
            fi

            # Resolve upstream file (agents use a directory with *.md glob)
            upstream_file=""
            if [[ "${CACHE_AVAILABLE}" == "true" ]] && [[ -d "${upstream_dir}" ]]; then
                for f in "${upstream_dir}"/*.md; do
                    [[ -f "${f}" ]] && upstream_file="${f}" && break
                done
            fi
            status=$(resolve_managed_status "agents" "${manifest_key}" "${agent_file}" "${upstream_file}")
            [[ "${status}" == "update available" ]] && UPDATES_AVAILABLE=true
            agent_desc=$(get_catalog_description "agents" "${agent_name}")
            agents_csv+=$'\n'"${agent_name}${SEP}${tool_name}${SEP}managed${SEP}${status}${SEP}${agent_desc}"
        else
            if has_upstream_conflict "${CACHE_DIR}/${SYSTEM_AGENTS_SUBDIR}/${agent_name}/${tool_name}"; then
                agents_csv+=$'\n'"${agent_name}${SEP}${tool_name}${SEP}user${SEP}conflicts with upstream${SEP}"
            else
                agents_csv+=$'\n'"${agent_name}${SEP}${tool_name}${SEP}user${SEP}${SEP}"
            fi
        fi
    done
done

# Show agent profiles available upstream but not installed locally
if [[ "${CACHE_AVAILABLE}" == "true" ]]; then
    upstream_agents_dir="${CACHE_DIR}/${SYSTEM_AGENTS_SUBDIR}"
    if [[ -d "${upstream_agents_dir}" ]]; then
        for agent_dir in "${upstream_agents_dir}"/*/; do
            [[ -d "${agent_dir}" ]] || continue
            agent_name=$(basename "${agent_dir}")
            for tool_dir in "${agent_dir}"/*/; do
                [[ -d "${tool_dir}" ]] || continue
                tool_name=$(basename "${tool_dir}")
                # Only consider tools in the registry
                [[ -z "${AGENT_TOOL_INSTALL_DIR[${tool_name}]+_}" ]] && continue
                # Needs at least one .md file
                compgen -G "${tool_dir}/*.md" >/dev/null || continue
                # Skip if already seen locally
                manifest_key="${agent_name}/${tool_name}"
                [[ -n "${seen_agents[${manifest_key}]+_}" ]] && continue
                agents_found=true
                NEW_RESOURCES_AVAILABLE=true
                new_agent_desc=$(get_catalog_description "agents" "${agent_name}")
                agents_csv+=$'\n'"${agent_name}${SEP}${tool_name}${SEP}available${SEP}not installed${SEP}${new_agent_desc}"
            done
        done
    fi
fi

print_label "Agent Profiles"
if [[ "${agents_found}" = true ]]; then
    render_table "${agents_csv}"
else
    echo "  (no agent profiles installed)"
fi

for _tid in "${sorted_tool_ids[@]}"; do
    print_tool_issues "${_tid}"
done

# --- Footer ---

echo ""
if [[ -f "${MANIFEST_PATH}" ]]; then
    print_faint "Manifest: ${MANIFEST_PATH}"
else
    log_warn "No manifest found. Run '${HARNESS_RUNNER} sf-harness-sync' to sync."
fi
if [[ "${CACHE_AVAILABLE}" == "false" ]]; then
    log_warn "No upstream cache found. Run '${HARNESS_RUNNER} sf-harness-sync' to enable update checks."
fi
if [[ "${CONFLICTS_FOUND}" == "true" ]]; then
    log_warn "Some user resources conflict with upstream. Run '${HARNESS_RUNNER} sf-harness-sync force' to overwrite."
fi
if [[ "${ORPHANS_FOUND}" == "true" ]]; then
    log_warn "Orphaned resources detected (removed from upstream). Run '${HARNESS_RUNNER} sf-harness-sync' to clean up."
fi
if [[ "${UPDATES_AVAILABLE}" == "true" ]]; then
    log_warn "Updates available. Run '${HARNESS_RUNNER} sf-harness-sync' to update."
fi
if [[ "${NEW_RESOURCES_AVAILABLE}" == "true" ]]; then
    log_warn "New resources available. Run '${HARNESS_RUNNER} sf-harness-sync' to install."
fi
if [[ "${RELOCATIONS_FOUND}" == "true" ]]; then
    log_warn "Some skills moved to another category. Enable it with '${HARNESS_RUNNER} sf-harness-category enable <category>' to keep using them."
fi
if [[ "${DISABLED_SKILLS_FOUND}" == "true" ]] && [[ -d "${HOME}/.config/opencode" ]]; then
    log_warn "OpenCode reads ${SKILLS_DIR} directly, so it still loads disabled skills."
fi
